rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function temPerfil() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function perfil() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function ehAdmin() { return logado() && temPerfil() && perfil().papel == 'admin'; }
    function ehEquipe() { return logado() && temPerfil() && perfil().papel in ['admin', 'professor']; }

    // Perfis: cada pessoa lê o próprio; só o admin cria ou altera.
    match /users/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      allow write: if ehAdmin();
    }

    // Conteúdo público: qualquer pessoa lê; só admin e professores editam.
    match /avisos/{id} {
      allow read: if true;
      allow write: if ehEquipe();
    }
    match /eventos/{id} {
      allow read: if true;
      allow write: if ehEquipe();
    }

    // Todo o resto fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
