rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quem é quem ----------
    function logado() { return request.auth != null; }
    function temPerfil() { return logado() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function perfil() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function ehAdmin() { return temPerfil() && perfil().papel == 'admin'; }
    function ehProfessor() { return temPerfil() && perfil().papel == 'professor'; }
    function ehEquipe() { return ehAdmin() || ehProfessor(); }
    function ehProprio(uid) { return logado() && request.auth.uid == uid; }
    function minhasTurmas() { return perfil().get('turmas', []); }
    // Professor vê só as turmas dele; o admin vê todas.
    function daMinhaTurma(turma) { return ehProfessor() && turma in minhasTurmas(); }
    // Qualquer professor pode cuidar de qualquer aluno (o que ele muda fica registrado para o administrador).
    function alunoDaMinhaTurma(uid) {
      return ehProfessor() && get(/databases/$(database)/documents/users/$(uid)).data.get('papel', '') == 'aluno';
    }

    // ---------- Validações ----------
    function texto(campo, max) {
      return request.resource.data[campo] is string
        && request.resource.data[campo].size() > 0
        && request.resource.data[campo].size() <= max;
    }
    function dataValida() {
      return request.resource.data.data is string && request.resource.data.data.size() == 10;
    }
    function numeroOuNulo(campo) {
      return request.resource.data.get(campo, null) == null
        || (request.resource.data[campo] is number && request.resource.data[campo] > 0 && request.resource.data[campo] < 400);
    }

    // ---------- Perfis ----------
    // O aluno lê o próprio; o professor lê os alunos das turmas dele; o admin lê todos.
    // Só o admin cria e altera. O aluno só pode marcar que já trocou a senha provisória.
    match /users/{uid} {
      allow read: if ehProprio(uid) || ehAdmin()
        || (ehProfessor() && resource.data.get('papel', '') == 'aluno');
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin()
        || (ehProfessor() && resource.data.get('papel', '') == 'aluno' && request.resource.data.get('papel', '') == 'aluno'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'apelido', 'dataNascimento', 'faixa', 'faixaDesde', 'dan', 'sexo', 'responsavel', 'telResponsavel', 'autorizaImagem', 'academia', 'email', 'celular', 'liberadoAte', 'foto', 'fotoAjuste', 'banner', 'bannerAjuste']))
        || (ehProprio(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['precisaTrocarSenha', 'apelido', 'email', 'celular', 'dataNascimento', 'sexo', 'responsavel', 'telResponsavel', 'autorizaImagem', 'foto', 'fotoAjuste', 'banner', 'bannerAjuste', 'login'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['login']) || request.resource.data.login == request.auth.token.email)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['precisaTrocarSenha']) || request.resource.data.precisaTrocarSenha == false)
            && request.resource.data.get('apelido', '') is string && request.resource.data.get('apelido', '').size() <= 40
            && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 120
            && request.resource.data.get('celular', '') is string && request.resource.data.get('celular', '').size() <= 20
            && request.resource.data.get('dataNascimento', '') is string && request.resource.data.get('dataNascimento', '').size() <= 10
            && request.resource.data.get('foto', '') is string && request.resource.data.get('foto', '').size() <= 300
            && request.resource.data.get('banner', '') is string && request.resource.data.get('banner', '').size() <= 300
            && request.resource.data.get('fotoAjuste', {}) is map && request.resource.data.get('bannerAjuste', {}) is map);

      match /medidas/{id} {
        allow read: if ehProprio(uid) || ehAdmin() || alunoDaMinhaTurma(uid);
        allow create: if (ehProprio(uid) || ehAdmin() || alunoDaMinhaTurma(uid))
          && request.resource.data.keys().hasOnly(['data', 'peso', 'altura', 'criadoEm'])
          && request.resource.data.data is string && request.resource.data.data.size() == 10
          && numeroOuNulo('peso') && numeroOuNulo('altura');
        allow delete: if ehProprio(uid) || ehAdmin();
      }

      // Campeonatos: o professor da turma (ou o admin) registra; o aluno só vê.
      match /campeonatos/{id} {
        allow read: if ehProprio(uid) || ehAdmin() || alunoDaMinhaTurma(uid);
        allow create, update: if (ehAdmin() || alunoDaMinhaTurma(uid))
          && texto('nome', 100) && request.resource.data.data is string && request.resource.data.data.size() == 10
          && request.resource.data.get('lutas', []) is list && request.resource.data.get('lutas', []).size() <= 20
          && request.resource.data.get('chave', []) is list && request.resource.data.get('chave', []).size() <= 64
          && request.resource.data.get('midias', []) is list && request.resource.data.get('midias', []).size() <= 30;
        allow delete: if ehAdmin() || alunoDaMinhaTurma(uid);
      }

      // Checklist de autoavaliação da faixa: o aluno marca; o professor e o admin veem e podem marcar.
      match /checklist/{faixa} {
        allow read: if ehProprio(uid) || ehAdmin() || alunoDaMinhaTurma(uid);
        allow write: if (ehProprio(uid) || ehAdmin() || alunoDaMinhaTurma(uid))
          && request.resource.data.keys().hasOnly(['itens', 'ts']) && request.resource.data.itens is map;
      }

      // Galeria pessoal: o próprio aluno, o professor da turma e o admin colocam e tiram.
      match /galeria/{id} {
        allow read, delete: if ehProprio(uid) || ehAdmin() || alunoDaMinhaTurma(uid);
        allow create: if (ehProprio(uid) || ehAdmin() || alunoDaMinhaTurma(uid))
          && request.resource.data.keys().hasOnly(['url', 'legenda', 'autor', 'ts'])
          && request.resource.data.url is string && request.resource.data.url.size() <= 300
          && request.resource.data.url.matches('^(https://|db:).*')
          && request.resource.data.legenda is string && request.resource.data.legenda.size() <= 120
          && request.resource.data.autor is string && request.resource.data.autor.size() <= 100;
      }

      // Anotações de aula: privadas, só o aluno lê e escreve.
      match /notas/{id} {
        allow read, delete: if ehProprio(uid);
        allow create: if ehProprio(uid)
          && request.resource.data.keys().hasOnly(['data', 'texto', 'criadoEm'])
          && request.resource.data.data is string && request.resource.data.data.size() == 10
          && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1500;
      }

      match /simulados/{id} {
        allow read: if ehProprio(uid) || ehAdmin() || alunoDaMinhaTurma(uid);
        allow create: if ehProprio(uid)
          && request.resource.data.keys().hasOnly(['data', 'titulo', 'simuladoId', 'acertos', 'total', 'respostas', 'ts', 'criadoEm'])
          && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 80
          && request.resource.data.get('respostas', []) is list && request.resource.data.get('respostas', []).size() <= 100
          && request.resource.data.acertos is int && request.resource.data.total is int
          && request.resource.data.acertos >= 0 && request.resource.data.acertos <= request.resource.data.total
          && request.resource.data.total > 0 && request.resource.data.total <= 500;
      }
    }

    // Pedidos de nova senha: qualquer pessoa pode deixar um (na tela de entrada); só o admin lê e apaga.
    match /pedidosSenha/{id} {
      allow read, delete: if ehAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['identificador', 'ts'])
        && request.resource.data.identificador is string && request.resource.data.identificador.size() > 2 && request.resource.data.identificador.size() <= 120
        && request.resource.data.ts is number;
    }

    // Apelido interno: só o admin vê e edita.
    match /usersInterno/{uid} {
      allow read, write: if ehAdmin();
    }

    // Turmas: a equipe lê; o aluno lê só a turma dele; só o admin cria, edita e apaga.
    match /turmas/{id} {
      allow read: if ehEquipe() || (temPerfil() && perfil().get('academia', '') == resource.data.get('nome', ''));
      allow create, update: if ehAdmin() && texto('nome', 60)
        && request.resource.data.get('apelido', '') is string && request.resource.data.get('apelido', '').size() <= 60
        && request.resource.data.get('descricao', '') is string && request.resource.data.get('descricao', '').size() <= 300
        && request.resource.data.get('localNome', '') is string && request.resource.data.get('localNome', '').size() <= 80
        && request.resource.data.get('endereco', '') is string && request.resource.data.get('endereco', '').size() <= 200
        && request.resource.data.get('horarios', '') is string && request.resource.data.get('horarios', '').size() <= 400
        && request.resource.data.get('grupoWhatsApp', '') is string && request.resource.data.get('grupoWhatsApp', '').size() <= 200
        && (request.resource.data.get('grupoWhatsApp', '') == '' || request.resource.data.get('grupoWhatsApp', '').matches('^https://.*'))
        && request.resource.data.get('dias', []) is list && request.resource.data.get('dias', []).size() <= 7;
      allow delete: if ehAdmin();
    }

    // Avisos de cada turma: o aluno e o professor da turma leem; admin e professor da turma publicam.
    match /avisosTurma/{id} {
      allow read: if ehAdmin() || daMinhaTurma(resource.data.get('turma', ''))
        || (temPerfil() && perfil().get('academia', '') == resource.data.get('turma', ''));
      allow create: if (ehAdmin() || daMinhaTurma(request.resource.data.get('turma', '')))
        && texto('titulo', 80) && texto('texto', 600) && dataValida()
        && request.resource.data.turma is string && request.resource.data.turma.size() > 0;
      allow update: if ehAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['turma']);
      allow delete: if ehAdmin() || daMinhaTurma(resource.data.get('turma', ''));
    }

    // Resultados de simulados: o aluno envia o próprio; o professor lê só a turma dele; o admin lê tudo.
    match /resultados/{id} {
      allow read: if ehAdmin() || daMinhaTurma(resource.data.get('academia', ''));
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'apelido', 'academia', 'simuladoId', 'titulo', 'acertos', 'total', 'data', 'ts', 'respostas'])
        && request.resource.data.get('respostas', []) is list && request.resource.data.get('respostas', []).size() <= 60
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.acertos is int && request.resource.data.total is int
        && request.resource.data.acertos >= 0 && request.resource.data.acertos <= request.resource.data.total
        && request.resource.data.total > 0 && request.resource.data.total <= 500
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 80
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 100
        && request.resource.data.ts is number;
      allow update: if ehAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['academia']);
      allow delete: if ehAdmin();
    }

    // ---------- Conteúdo público (a equipe edita) ----------
    match /avisos/{id} {
      allow read: if true;
      allow create, update: if ehEquipe() && texto('titulo', 80) && texto('texto', 600) && dataValida()
        && request.resource.data.get('autor', '') is string && request.resource.data.get('autor', '').size() <= 100
        && request.resource.data.get('imagem', '') is string && request.resource.data.get('imagem', '').size() <= 300
        && request.resource.data.get('video', '') is string && request.resource.data.get('video', '').size() <= 300;
      allow delete: if ehEquipe();
    }
    match /eventos/{id} {
      allow read: if true;
      allow create, update: if ehEquipe() && texto('titulo', 80) && texto('hora', 30)
        && texto('local', 80) && texto('tipo', 30) && dataValida()
        && request.resource.data.get('descricao', '') is string && request.resource.data.get('descricao', '').size() <= 400
        && request.resource.data.get('autor', '') is string && request.resource.data.get('autor', '').size() <= 100
        && request.resource.data.get('imagem', '') is string && request.resource.data.get('imagem', '').size() <= 300
        && request.resource.data.get('video', '') is string && request.resource.data.get('video', '').size() <= 300
        && request.resource.data.get('pastaDrive', '') is string && request.resource.data.get('pastaDrive', '').size() <= 300;
      allow delete: if ehEquipe();
    }
    match /tecnicas/{id} {
      allow read: if true;
      allow create, update: if ehEquipe()
        && request.resource.data.keys().hasOnly(['faixa', 'pdf', 'video', 'nota', 'imagem', 'links', 'nome', 'proibida', 'ocultar', 'custom', 'categoria', 'familia', 'grupo', 'sequencias', 'contragolpes', 'midias'])
        && request.resource.data.get('midias', []) is list && request.resource.data.get('midias', []).size() <= 12
        && request.resource.data.get('sequencias', []) is list && request.resource.data.get('sequencias', []).size() <= 20
        && request.resource.data.get('contragolpes', []) is list && request.resource.data.get('contragolpes', []).size() <= 20
        && request.resource.data.faixa is string && request.resource.data.faixa.size() <= 20
        && request.resource.data.pdf is string && request.resource.data.pdf.size() <= 300
        && (request.resource.data.pdf == '' || request.resource.data.pdf.matches('^https://.*'))
        && request.resource.data.video is string && request.resource.data.video.size() <= 300
        && (request.resource.data.video == '' || request.resource.data.video.matches('^https://.*'))
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 200
        && request.resource.data.get('imagem', '') is string && request.resource.data.get('imagem', '').size() <= 300
        && (request.resource.data.get('imagem', '') == '' || request.resource.data.get('imagem', '').matches('^(https://|/|db:).*'))
        && request.resource.data.get('links', []) is list && request.resource.data.get('links', []).size() <= 10
        && request.resource.data.get('nome', '') is string && request.resource.data.get('nome', '').size() <= 60
        && request.resource.data.get('ocultar', false) is bool && request.resource.data.get('custom', false) is bool
        && request.resource.data.get('proibida', false) is bool
        && request.resource.data.get('categoria', '') is string && request.resource.data.get('categoria', '').size() <= 30
        && request.resource.data.get('familia', '') is string && request.resource.data.get('familia', '').size() <= 30
        && request.resource.data.get('grupo', '') is string && request.resource.data.get('grupo', '').size() <= 30;
      allow delete: if ehEquipe();
    }
    match /palavras/{id} {
      allow read: if true;
      allow create, update: if ehEquipe()
        && texto('termo', 60) && texto('significado', 200)
        && request.resource.data.get('listas', []) is list && request.resource.data.get('listas', []).size() <= 30;
      allow delete: if ehEquipe();
    }
    match /listasPalavras/{id} {
      allow read: if true;
      allow create, update: if ehEquipe() && texto('nome', 60);
      allow delete: if ehEquipe();
    }
    match /exercicios/{id} {
      allow read: if true;
      allow create, update: if ehEquipe() && texto('nome', 60)
        && request.resource.data.get('descricao', '') is string && request.resource.data.get('descricao', '').size() <= 200;
      allow delete: if ehEquipe();
    }
    match /simulados/{id} {
      allow read: if true;
      allow create, update: if ehEquipe()
        && texto('titulo', 80)
        && request.resource.data.perguntas is list && request.resource.data.perguntas.size() <= 300;
      allow delete: if ehEquipe();
    }
    match /katas/{id} {
      allow read: if true;
      allow create, update: if ehEquipe()
        && request.resource.data.get('videos', []) is list && request.resource.data.get('videos', []).size() <= 20
        && request.resource.data.get('imagens', []) is list && request.resource.data.get('imagens', []).size() <= 40
        && request.resource.data.get('nome', '') is string && request.resource.data.get('nome', '').size() <= 60
        && request.resource.data.get('dan', '') is string && request.resource.data.get('dan', '').size() <= 80
        && request.resource.data.get('resumo', '') is string && request.resource.data.get('resumo', '').size() <= 300
        && request.resource.data.get('series', []) is list && request.resource.data.get('series', []).size() <= 30;
      allow delete: if ehEquipe();
    }
    match /galeria/{id} {
      allow read: if true;
      allow create, update: if ehEquipe() && texto('legenda', 80) && texto('url', 300)
        && request.resource.data.url.matches('^(https://|/|db:).*');
      allow delete: if ehEquipe();
    }

    // Imagens enviadas pelo painel (já reduzidas no celular): todos veem; a equipe envia.
    match /imagens/{id} {
      allow read: if true;
      // Qualquer pessoa cadastrada (inclusive aluno, para a galeria dele) pode enviar imagens já reduzidas.
      allow create: if temPerfil()
        && request.resource.data.keys().hasOnly(['dados', 'ts'])
        && request.resource.data.dados is string
        && request.resource.data.dados.size() <= 800000
        && request.resource.data.dados.matches('data:image/.*');
      allow delete: if ehEquipe();
    }

    // Desempenho na roleta de palavras: o aluno grava o dele; o professor lê só a turma dele; o admin lê tudo.
    match /desempenhoPalavras/{id} {
      allow read: if ehProprio(resource.data.get('uid', '')) || ehAdmin() || daMinhaTurma(resource.data.get('turma', ''));
      allow create, update: if logado()
        && request.resource.data.keys().hasOnly(['uid', 'turma', 'termo', 'acertos', 'erros', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.termo is string && request.resource.data.termo.size() > 0 && request.resource.data.termo.size() <= 60
        && request.resource.data.turma is string && request.resource.data.turma.size() <= 60
        && request.resource.data.acertos is int && request.resource.data.acertos >= 0
        && request.resource.data.erros is int && request.resource.data.erros >= 0
        && request.resource.data.ts is number;
      allow delete: if ehAdmin();
    }

    // Feriados locais, calendários oficiais (imagem ou PDF) e parcerias.
    match /feriados/{id} {
      allow read: if true;
      allow create, update: if ehEquipe() && texto('nome', 60) && request.resource.data.data is string && request.resource.data.data.size() == 10;
      allow delete: if ehEquipe();
    }
    match /calendariosOficiais/{id} {
      allow read: if true;
      allow create, update: if ehEquipe() && texto('titulo', 80) && texto('url', 300)
        && request.resource.data.tipo in ['imagem', 'pdf']
        && request.resource.data.url.matches('^(https://|/|db:).*');
      allow delete: if ehEquipe();
    }
    match /parcerias/{id} {
      allow read: if true;
      allow create, update: if ehAdmin() && texto('nome', 60)
        && request.resource.data.get('descricao', '') is string && request.resource.data.get('descricao', '').size() <= 600
        && request.resource.data.get('url', '') is string && request.resource.data.get('url', '').size() <= 300
        && (request.resource.data.get('url', '') == '' || request.resource.data.get('url', '').matches('^https://.*'))
        && request.resource.data.get('logo', '') is string && request.resource.data.get('logo', '').size() <= 300
        && request.resource.data.get('desconto', '') is string && request.resource.data.get('desconto', '').size() <= 100
        && request.resource.data.get('categoria', '') is string && request.resource.data.get('categoria', '').size() <= 40
        && request.resource.data.get('cupom', '') is string && request.resource.data.get('cupom', '').size() <= 40
        && request.resource.data.get('banner', '') is string && request.resource.data.get('banner', '').size() <= 300
        && request.resource.data.get('destaque', false) is bool
        && request.resource.data.get('produtos', []) is list && request.resource.data.get('produtos', []).size() <= 30;
      allow delete: if ehAdmin();
    }

    // Materiais de estudo (PDFs, apostilas, vídeos e links): todos leem; a equipe publica.
    match /materiais/{id} {
      allow read: if true;
      allow create, update: if ehEquipe() && texto('titulo', 100) && texto('url', 300)
        && request.resource.data.url.matches('^https://.*')
        && request.resource.data.get('descricao', '') is string && request.resource.data.get('descricao', '').size() <= 200
        && request.resource.data.get('tipo', '') is string && request.resource.data.get('tipo', '').size() <= 20
        && request.resource.data.get('categoria', '') is string && request.resource.data.get('categoria', '').size() <= 40
        && request.resource.data.get('faixa', '') is string && request.resource.data.get('faixa', '').size() <= 30;
      allow delete: if ehEquipe();
    }

    // Roletas criadas pelo professor.
    match /roletas/{id} {
      allow read: if true;
      allow create, update: if ehEquipe() && texto('titulo', 60)
        && request.resource.data.itens is list && request.resource.data.itens.size() >= 2 && request.resource.data.itens.size() <= 100;
      allow delete: if ehEquipe();
    }

    // Aniversários (só apelido/primeiro nome e dia/mês): só quem está logado vê.
    match /aniversarios/{uid} {
      allow read: if temPerfil();
      allow create, update: if (ehAdmin() || ehProprio(uid) || alunoDaMinhaTurma(uid))
        && request.resource.data.keys().hasOnly(['nome', 'mmdd'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 40
        && request.resource.data.mmdd is string && request.resource.data.mmdd.size() == 5;
      allow delete: if ehAdmin() || ehProprio(uid) || alunoDaMinhaTurma(uid);
    }

    // Campeonatos do dojô: os públicos todos veem; os só dos alunos, quem está cadastrado. A equipe cuida.
    match /campeonatos/{id} {
      allow read: if resource.data.get('publico', false) == true || temPerfil();
      allow create, update: if ehEquipe() && texto('nome', 100)
        && request.resource.data.data is string && request.resource.data.data.size() == 10
        && request.resource.data.publico is bool
        && request.resource.data.get('descricao', '') is string && request.resource.data.get('descricao', '').size() <= 1500
        && request.resource.data.get('arquivos', []) is list && request.resource.data.get('arquivos', []).size() <= 12;
      allow delete: if ehAdmin() || (ehProfessor() && resource.data.get('autor', '') == perfil().get('nome', ''));

      // Inscritos: quem está cadastrado vê; a equipe inscreve.
      match /inscritos/{uid} {
        allow read: if temPerfil();
        allow write: if ehEquipe();
      }
      // Comprovante de pagamento ou documento: só o administrador e o professor da turma do aluno.
      match /comprovantes/{uid} {
        allow read: if ehAdmin() || daMinhaTurma(resource.data.get('turma', ''));
        allow create, update: if ehEquipe() && request.resource.data.url is string && request.resource.data.url.size() <= 300;
        allow delete: if ehEquipe();
      }
    }

    // Eventos só do calendário dos alunos (quem está cadastrado).
    match /eventosInternos/{id} {
      allow read: if temPerfil();
      allow create, update: if ehEquipe() && texto('titulo', 80) && dataValida();
      allow delete: if ehEquipe();
    }

    // Chamadas: a equipe faz; o aluno vê as chamadas em que está presente.
    match /chamadas/{id} {
      allow read: if ehEquipe() || (logado() && request.auth.uid in resource.data.get('presentes', []));
      allow create, update: if ehEquipe()
        && request.resource.data.turma is string && request.resource.data.data is string && request.resource.data.data.size() == 10
        && request.resource.data.presentes is list && request.resource.data.presentes.size() <= 200
        && request.resource.data.get('obs', '') is string && request.resource.data.get('obs', '').size() <= 1000
        && request.resource.data.get('visitantes', []) is list && request.resource.data.get('visitantes', []).size() <= 30;
      allow delete: if ehAdmin();
    }

    // Celulares que recebem notificação: cada pessoa registra o próprio; o servidor (chave de serviço) envia.
    match /pushTokens/{token} {
      allow create, update: if logado() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'turma', 'papel', 'ts']);
      allow read, delete: if logado() && (resource.data.uid == request.auth.uid || ehAdmin());
    }

    // Sugestões: quem está cadastrado manda; vê as próprias; o administrador vê todas e responde.
    match /sugestoes/{id} {
      allow create: if temPerfil() && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 2000
        && request.resource.data.get('imagem', '') is string && request.resource.data.get('imagem', '').size() <= 300
        && request.resource.data.get('video', '') is string && request.resource.data.get('video', '').size() <= 300
        && request.resource.data.status == 'Nova' && request.resource.data.resposta == '';
      allow read: if ehAdmin() || (logado() && resource.data.uid == request.auth.uid);
      allow update: if ehAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resposta']);
      allow delete: if ehAdmin();
    }

    // Mensalidades: só o administrador marca; o aluno vê as dele.
    match /mensalidades/{id} {
      allow read: if ehAdmin() || (logado() && resource.data.uid == request.auth.uid);
      allow write: if ehAdmin();
    }

    // Pedidos de aula experimental: qualquer pessoa pede (página pública); a equipe vê e acompanha.
    match /experimentais/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'idade', 'telefone', 'turma', 'horario', 'mensagem', 'menor', 'responsavel', 'telResponsavel', 'status', 'obs', 'ts'])
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 100
        && request.resource.data.telefone is string && request.resource.data.telefone.size() >= 10 && request.resource.data.telefone.size() <= 20
        && request.resource.data.get('mensagem', '') is string && request.resource.data.get('mensagem', '').size() <= 600
        && request.resource.data.status == 'Novo';
      allow read, update: if ehEquipe();
      allow delete: if ehAdmin();
    }

    // Atividades: cada pessoa registra o que ela mesma mudou; só o admin lê e apaga.
    match /atividades/{id} {
      allow read: if ehAdmin() || daMinhaTurma(resource.data.get('turma', ''));
      allow delete: if ehAdmin();
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'texto', 'ts', 'turma'])
        && request.resource.data.get('turma', '') is string && request.resource.data.get('turma', '').size() <= 60
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 100
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 300
        && request.resource.data.ts is number;
    }

    // Configurações do site (textos da página inicial, banner, logo, efeitos): só o admin edita.
    match /config/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Planejamento de aulas: cada professor só vê e edita as próprias aulas.
    match /aulas/{id} {
      allow read, delete: if ehEquipe() && (resource.data.dono == request.auth.uid || ehAdmin());
      allow create: if ehEquipe() && request.resource.data.dono == request.auth.uid
        && texto('titulo', 80) && dataValida();
      allow update: if ehEquipe() && resource.data.dono == request.auth.uid
        && request.resource.data.dono == request.auth.uid && texto('titulo', 80) && dataValida();
    }

    // Todo o resto fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
